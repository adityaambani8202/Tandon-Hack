<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/HS.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your visits" />

        <TextView
            style="@style/HS.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="We'll remind you the day before and 2 hours before each one." />

        <!-- Filled in by VisitsFragment.java -->
        <LinearLayout
            android:id="@+id/visits_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
