<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Greeting -->
        <TextView
            android:id="@+id/text_date"
            style="@style/HS.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_greeting"
            style="@style/HS.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/text_day"
            style="@style/HS.Text.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <!-- Progress card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/HS.Card.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/teal"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_progress_count"
                    style="@style/HS.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/HS.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="medicines taken today"
                    android:textColor="@color/white" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    app:indicatorColor="@color/white"
                    app:trackColor="@color/white_faded"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="12dp" />

                <TextView
                    android:id="@+id/text_progress_message"
                    style="@style/HS.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Up next -->
        <TextView
            style="@style/HS.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up next" />

        <FrameLayout
            android:id="@+id/up_next_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Daily check-in prompt -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_checkin"
            style="@style/HS.Card.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/peach_soft"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/HS.Badge"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/peach_dark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HS.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily check-in" />

                    <TextView
                        style="@style/HS.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How are you feeling? Takes 30 seconds." />
                </LinearLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/peach_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Next visit -->
        <TextView
            style="@style/HS.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next visit" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_next_visit"
            style="@style/HS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/next_visit_date"
                    layout="@layout/view_date_badge" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_next_visit_title"
                        style="@style/HS.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_next_visit_time"
                        style="@style/HS.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Care rules -->
        <TextView
            style="@style/HS.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remember today" />

        <com.google.android.material.card.MaterialCardView
            style="@style/HS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/rules_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Scan new papers -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_scan"
            style="@style/HS.Card.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/teal_soft"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/HS.Badge"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_document"
                    app:tint="@color/teal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HS.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Got new papers?" />

                    <TextView
                        style="@style/HS.Text.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan them and we'll set up your plan for you." />
                </LinearLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/teal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
