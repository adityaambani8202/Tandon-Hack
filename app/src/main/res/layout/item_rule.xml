<?xml version="1.0" encoding="utf-8"?>
<!-- One line in "Remember today", e.g. "No lifting over 10 lbs" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/icon"
        style="@style/HS.Badge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:backgroundTint="@color/peach_soft"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info"
        app:tint="@color/peach_dark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_rule"
            style="@style/HS.Text.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_detail"
            style="@style/HS.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
